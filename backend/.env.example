# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Atlas or local replica set for transactions)
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.brmtxus.mongodb.net/supermarket_db?retryWrites=true&w=majority

# Client URLs (CORS & Cookie credentials)
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Authentication & JWT Secrets
JWT_SECRET=supermarket_secure_jwt_secret_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
CSRF_SECRET=supermarket_secure_csrf_secret_key_change_in_production

# Cookie Configuration
COOKIE_SECRET=supermarket_cookie_signing_secret_min_32_chars
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Email / SMTP Configuration (for Forgot/Reset Password)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Supermarket POS <no-reply@supermarket.local>"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
AUTH_RATE_LIMIT_MAX=15

# Supermarket Defaults
STORE_TIMEZONE=Africa/Mogadishu
DEFAULT_CURRENCY=USD
